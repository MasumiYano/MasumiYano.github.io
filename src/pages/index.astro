---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE } from "@/consts"
---

<Layout>
  <MetaPage slot="head" />
  <home-intro>
    <h1>{SITE.title}</h1>
    <p>{SITE.description}</p>
    <prose-content>
      <p>
        Hello, I'm Masumi Yano. I'm an MLE with interest in serving models as
        cheap as possible, as fast as possible, and as reliably as possible. I
        blog about ML techniques, life, and more (maybe)!
      </p>
      <p><a href="/blog">Read the blog →</a></p>
    </prose-content>
  </home-intro>
</Layout>

<style>
  home-intro {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    prose-content {
      margin-block-start: var(--space-m);
    }
  }
</style>
